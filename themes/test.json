{
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "name": "HCO-light-saturated",
  "include": "./default/2026-light.json",
  "colors": {
    // ======================================================
    // BACKGROUND
    // ======================================================
    // Editor
    "editor.background": "#FAFAFA",
    // Line numbers panel (on the left)
    "editorGutter.background": "#FAFAFA",
    // Breadcrumbrs
    "breadcrumb.background": "#FAFAFA",
    // Tabs panel
    "editorGroupHeader.tabsBackground": "#EBEBEC",
    // Tabs panel (inactive tabs)
    "tab.inactiveBackground": "#EBEBEC",
    // ======================================================
    // FOREGROUND
    // ======================================================
    "editor.foreground": "#1F2328",
    // ======================================================
    // BORDERS
    // ======================================================
    // Side panels: Border
    "sideBar.border": "#D7D7D7",
    // Terminal: Border
    "panel.border": "#D7D7D7",
    // Tabs panel: Side borders of tabs
    "tab.border": "#D7D7D7",
    // Tabs panel: Top border of active tab
    "tab.activeBorderTop": "#D7D7D7",
    // Tabs panel: Bottom border
    "editorGroupHeader.tabsBorder": "#D7D7D7",
    // Title bar: Bottom border (Top border of tabs panel)
    "titleBar.border": "#D7D7D7",
    // ======================================================
    // SELECTION
    // ======================================================
    // "editor.selectionBackground": "#a8d4ff",
    // "editor.selectionHighlightBackground": "#a8d4ff70",
    // ======================================================
    // BRACKETS AND BRACKET GUIDES
    // ======================================================
    // HTML scope ruler
    "editorIndentGuide.activeBackground1": "#1F2328",
    "editorBracketHighlight.foreground1": "#1F2328",
    "editorBracketHighlight.foreground2": "#1F2328",
    "editorBracketHighlight.foreground3": "#1F2328",
    "editorBracketHighlight.foreground4": "#1F2328",
    "editorBracketPairGuide.activeBackground1": "#1F2328",
    "editorBracketPairGuide.activeBackground2": "#1F2328",
    "editorBracketPairGuide.activeBackground3": "#1F2328",
    "editorBracketPairGuide.activeBackground4": "#1F2328"
  },
  "tokenColors": [
    {
      "scope": [
        // Comments
        "comment",
        // RegExp: Start/End of regexp expression /.../
        "string.regexp punctuation.definition.string",
        // RegExp: Escape backlashes
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#9e9e9e" /* Light */
      }
    },
    {
      "scope": [
        // TS: Variables (inside JSDoce syntax)
        "variable.other.jsdoc",
        // TS: Variables (inside template strings)
        "meta.embedded",
        // JSON: Property key name
        "support.type.property-name.json",
        // CSS: Property name and Media conditions
        "support.type.property-name",
        // Markdown: commands flags
        "constant.other.option",
        // TS: Disable "types" highlighting for "JS-modules"
        "entity.name.type.module",
        // TS: Disable "types" highlighting for "TS-Enums"
        "entity.name.type.enum",
        // TS: Disable "types" highlighting for "Namesapeses"
        "entity.name.type.namespace",
        // RegExp: Group parentheses "()"
        "punctuation.definition.group",
        // RegExp: Sets square brackets "[]"
        "punctuation.definition.character-class",
      ],
      "settings": {
        "foreground": "#1F2328" /* Light */
      }
    },
    {
      "scope": [
        // const, let, function
        "storage",
        // new, typeof,
        "keyword",
        // Optional operator "?"
        "punctuation.accessor.optional",
        // new
        "keyword.operator.new",
        // typeof
        "keyword.operator.expression",
        // Classes: this, super()
        "variable.language",
        // Operators and Symbols: = ! ?
        "keyword.operator",
        // Operators and Symbols: Arrow function
        "storage.type.function.arrow",
        // Operators and Symbols: Object's key/value colon
        "punctuation.separator.key-value",
        // JS/TS: First and last curly braces of variable inside template string
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#000be0" /* Light */
      }
    },
    {
      "scope": [
        // true/false
        "constant.language",
        // Numbers
        "constant.numeric",
        // Numbers with leading unit
        "keyword.other.unit",
        // Numbers with plus/minus before (+1)
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#0451a5" /* Light */
      }
    },
    {
      "scope": [
        // ==== CLASSES ====
        // TS: Class declaration
        "entity.name.type.class",
        // TS: Inherited class
        "entity.other.inherited-class",
        // TS: Promise
        "support.class"
      ],
      "settings": {
        "foreground": "#506795" /* Light */
      }
    },
    {
      "scope": [
        // User function name
        "entity.name.function",
        // CSS func
        "support.function"
      ],
      "settings": {
        // "foreground": "#148fb8" /* Light */
        "foreground": "#1492b8"
      }
    },
    {
      "scope": [
        // return, import, if/else
        "keyword.control"
      ],
      "settings": {
        "foreground": "#9b61d1" /* Light */
      }
    },
    {
      "scope": [
        // HTML tags
        "entity.name.tag",
        // JSX tags
        "support.class.component"
      ],
      "settings": {
        "foreground": "#a80000" /* Light */
      }
    },
    {
      "scope": [
        // Attributes
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ce8b7e" /* Light */
      }
    },
    {
      "scope": [
        // Strings
        "string",
        // Markdown: Code in backticks
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#3d922a" /* Light */
      }
    },
    {
      "scope": [
        // Markdown: Heading
        "markup.heading",
        // Markdown: Code inside heading
        "markup.heading markup.inline.raw",
        // Markdown: String inside heading
        "markup.heading string",
        // HTML: Escape sequence (&nbsp;)
        "constant.character"
      ],
      "settings": {
        "foreground": "#a21319" /* Light */
      }
    },
    {
      "scope": [
        // TS: Parameters (of function declarations)
        "meta.parameters variable.parameter",
        // TS: Parameters (of arrow functions)
        "meta.arrow variable.parameter",
        // TS: Parameters (of arrow functions; written from the new line)
        "meta.var variable.parameter"
      ],
      "settings": {
        // "foreground": "#ad661f" /* Light */
        "foreground": "#996633" /* Light */
      }
    },
    {
      "scope": [
        // TS: Type primitives
        "support.type",
        // TS: All "Types" and "Classes"
        "entity.name.type",
        // TS: Extended interface
        "meta.interface entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9c9121" /* Light */
      }
    },
    {
      "scope": [
        // Markdown: Heading
        "markup.heading",
        // Markdown: Bold
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        // return, import, if/else
        "keyword.control",
        // Comments
        "comment",
        // Markdown: italic formatting
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {}
}
